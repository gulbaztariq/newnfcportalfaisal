{
  "name": "nfc-vcards-server",
  "version": "1.0.0",
  "private": true,
  "description": "NFC / vCard SaaS - REST API, public vCards and landing page",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:sync": "node src/scripts/sync.js",
    "db:seed": "node src/scripts/seed.js",
    "db:reset": "node src/scripts/sync.js --force && node src/scripts/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nfc-vcards": "file:..",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.7",
    "sequelize": "^6.37.8",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "sqlite3": "^6.0.1"
  }
