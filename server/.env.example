# ---------- App ----------
NODE_ENV=development
PORT=5000
# Public URL of this server (landing page, vCards, API)
APP_URL=http://localhost:5000
# URL of the React app (in development the Vite dev server)
CLIENT_URL=http://localhost:5173
# Long random strings - CHANGE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string
IMPERSONATE_SECRET=change-me-too

# ---------- Database (MySQL) ----------
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nfc_vcards
DB_USER=root
DB_PASSWORD=
# For a quick local try-out without MySQL: DB_DIALECT=sqlite and DB_STORAGE=./dev.sqlite

# ---------- Mail (leave MAIL_HOST empty to log e-mails to the console) ----------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="NFC Profile <no-reply@example.com>"

# ---------- Seed ----------
SUPER_ADMIN_EMAIL=sadmin@vcard.com
SUPER_ADMIN_PASSWORD=123456
